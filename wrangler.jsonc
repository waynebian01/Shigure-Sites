{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shigure-sites",
  "account_id": "c77af5c085ecfa963e1f472b5d07999a",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shigure-sites-db",
      "database_id": "7583d82c-3d2e-4983-9556-7fd46dc9a317",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "shigure-sites-files"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
